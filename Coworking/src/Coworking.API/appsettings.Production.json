{
  "General": {
    "AutoMigrations": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterOptions": {
        "SingleLine": true,
        "JsonWriterOptions": {
          "Indented": false
        }
      }
    }
  },

  "AllowedOrigins": [
    "https://your-domain.com"
  ]
}
